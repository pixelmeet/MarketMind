# MarketMind AI — Environment Variable Template
# Copy this file to .env.local for local development.
# Do NOT commit secrets or real credentials to git (doc/security.md SEC-SEC-01).

# -----------------------------------------------------------------------------
# Runtime & Server Configuration
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Background worker mode: drain-and-exit (default for MVP) or loop
WORKER_MODE=drain-and-exit

# -----------------------------------------------------------------------------
# Client-Safe Public Configuration (NEXT_PUBLIC_ prefix required)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="MarketMind AI"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Placeholders for future phases (Unconfigured in Phase 2.1)
# -----------------------------------------------------------------------------
# DATABASE_URL="postgresql://user:password@localhost:5432/marketmind?schema=public"
# DIRECT_URL="postgresql://user:password@localhost:5432/marketmind?schema=public"
# AUTH_SECRET="your-32-byte-secret-here"
# AUDIT_PSEUDONYM_KEY="your-32-byte-hmac-key-here"
